    "import os, time\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib\n",
    "matplotlib.use(\"Agg\")\n",
    "import matplotlib.pyplot as plt\n",
    "import joblib\n",
    "from copy import deepcopy\n",
    "from scipy.sparse import csr_matrix, hstack as sp_hstack\n",
    "from sklearn.model_selection import StratifiedKFold\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.calibration import CalibratedClassifierCV\n",
    "from sklearn.svm import LinearSVC, SVC\n",
    "from sklearn.ensemble import RandomForestClassifier, StackingClassifier\n",
    "from sklearn.linear_model import LogisticRegression, SGDClassifier\n",
    "from sklearn.metrics import (accuracy_score, f1_score,\n",
    "                             precision_score, recall_score, roc_auc_score)\n",
    "from lightgbm import LGBMClassifier\n",
    "from xgboost import XGBClassifier\n",
    "RESULTS_DIR = \"/content/drive/MyDrive/Phishing_Email/results\"\n",
    "NLP_DIR     = \"/content/drive/MyDrive/Phishing_Email/nlp_features\"\n",
    "os.makedirs(RESULTS_DIR, exist_ok=True)\n",
    "numerical_features = joblib.load(f\"{NLP_DIR}/nlp_feature_names.pkl\")\n",
    "df_cv = pd.read_csv(\n",
    "    \"/content/drive/MyDrive/Phishing_Email/final_dataset/nlp_final_features_reduced.csv\"\n",
    ")\n",
    "X_text_cv = df_cv[\"clean_text\"].fillna(\"\").values\n",
    "X_num_cv  = df_cv[numerical_features].fillna(0).values\n",
    "y_cv      = df_cv[\"label\"].values\n",
    "print(f\"Dataset: {len(y_cv)} samples | \"\n",
    "      f\"Numerical features: {X_num_cv.shape[1]}\")\n",
    "def make_estimators():\n",
    "    svm_linear = CalibratedClassifierCV(\n",
    "        LinearSVC(C=1.0, class_weight=\"balanced\",\n",
    "                  random_state=42, max_iter=10000),\n",
    "        cv=3\n",
    "    )\n",
    "    svm_kernel = SVC(\n",
    "        C=1.0, kernel=\"rbf\", gamma=\"scale\",\n",
    "        class_weight=\"balanced\", probability=True, random_state=42\n",
    "    )\n",
    "    rf = RandomForestClassifier(\n",
    "        n_estimators=100, class_weight=\"balanced\",\n",
    "        random_state=42, n_jobs=-1\n",
    "    )\n",
    "    lgbm = LGBMClassifier(\n",
    "        n_estimators=300, max_depth=-1, learning_rate=0.05,\n",
    "        subsample=0.8, colsample_bytree=0.8,\n",
    "        class_weight=\"balanced\", random_state=42, n_jobs=-1\n",
    "    )\n",
    "    stacking = StackingClassifier(\n",
    "        estimators=[\n",
    "            (\"lr\",   LogisticRegression(max_iter=10000, class_weight=\"balanced\", random_state=42)),\n",
    "            (\"rf\",   RandomForestClassifier(n_estimators=200, class_weight=\"balanced\", random_state=42, n_jobs=-1)),\n",
    "            (\"xgb\",  XGBClassifier(n_estimators=200, max_depth=6, learning_rate=0.1, random_state=42, eval_metric=\"logloss\")),\n",
    "            (\"lgbm\", LGBMClassifier(n_estimators=200, learning_rate=0.05, class_weight=\"balanced\", random_state=42, n_jobs=-1)),\n",
    "            (\"svm\",  SGDClassifier(loss=\"log_loss\", class_weight=\"balanced\", max_iter=2000, random_state=42)),\n",
    "        ],\n",
    "        final_estimator=LogisticRegression(max_iter=10000, random_state=42),\n",
    "        cv=5, n_jobs=-1, passthrough=False\n",
    "    )\n",
    "    return [\n",
    "        (\"Linear SVM\",          svm_linear, True),\n",
    "        (\"Kernel SVM\",          svm_kernel, True),\n",
    "        (\"Random Forest\",       rf,         True),\n",
    "        (\"LightGBM\",            lgbm,       False),\n",
    "        (\"Stacking Classifier\", stacking,   False),\n",
    "    ]\n",
    "CV      = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "METRICS = [\"accuracy\", \"f1\", \"precision\", \"recall\", \"roc_auc\"]\n",
    "print(\"\\n\" + \"=\" * 65)\n",
    "print(\"  5-FOLD STRATIFIED CROSS-VALIDATION  (fold-wise TF-IDF fit)\")\n",
    "print(\"=\" * 65)\n",
    "cv_records = []\n",
    "for name, base_est, use_num in make_estimators():\n",
    "    print(f\"\\n  [{name}] running...\", flush=True)\n",
    "    t0 = time.time()\n",
    "    fold_acc, fold_f1, fold_prec, fold_rec, fold_auc = [], [], [], [], []\n",
    "    for fold_idx, (train_idx, test_idx) in enumerate(CV.split(X_text_cv, y_cv)):\n",
    "        tfidf_fold = TfidfVectorizer(max_features=5000, ngram_range=(1, 2))\n",
    "        X_tr_tfidf = tfidf_fold.fit_transform(X_text_cv[train_idx])\n",
    "        X_te_tfidf = tfidf_fold.transform(X_text_cv[test_idx])\n",
    "        if use_num:\n",
    "            scaler_fold = StandardScaler(with_mean=False)\n",
    "            X_tr_num = csr_matrix(\n",
    "                scaler_fold.fit_transform(X_num_cv[train_idx])\n",
    "            )\n",
    "            X_te_num = csr_matrix(\n",
    "                scaler_fold.transform(X_num_cv[test_idx])\n",
    "            )\n",
    "            X_tr = sp_hstack([X_tr_tfidf, X_tr_num])\n",
    "            X_te = sp_hstack([X_te_tfidf, X_te_num])\n",
    "        else:\n",
    "            X_tr = X_tr_tfidf\n",
    "            X_te = X_te_tfidf\n",
    "        est = deepcopy(base_est)\n",
    "        est.fit(X_tr, y_cv[train_idx])\n",
    "        y_pred = est.predict(X_te)\n",
    "        if hasattr(est, \"predict_proba\"):\n",
    "            y_prob = est.predict_proba(X_te)[:, 1]\n",
    "        else:\n",
    "            y_prob = est.decision_function(X_te)\n",
    "        fold_acc.append(accuracy_score(y_cv[test_idx], y_pred))\n",
    "        fold_f1.append(f1_score(y_cv[test_idx], y_pred, zero_division=0))\n",
    "        fold_prec.append(precision_score(y_cv[test_idx], y_pred, zero_division=0))\n",
    "        fold_rec.append(recall_score(y_cv[test_idx], y_pred, zero_division=0))\n",
    "        fold_auc.append(roc_auc_score(y_cv[test_idx], y_prob))\n",
    "        print(f\"    Fold {fold_idx+1}: acc={fold_acc[-1]:.4f}  \"\n",
    "              f\"f1={fold_f1[-1]:.4f}  auc={fold_auc[-1]:.4f}\", flush=True)\n",
    "    elapsed = time.time() - t0\n",
    "    r = {\n",
    "        \"Model\":        name,\n",
    "        \"CV Accuracy\":  f\"{np.mean(fold_acc):.4f} ± {np.std(fold_acc):.4f}\",\n",
    "        \"CV F1\":        f\"{np.mean(fold_f1):.4f} ± {np.std(fold_f1):.4f}\",\n",
    "        \"CV Precision\": f\"{np.mean(fold_prec):.4f} ± {np.std(fold_prec):.4f}\",\n",
    "        \"CV Recall\":    f\"{np.mean(fold_rec):.4f} ± {np.std(fold_rec):.4f}\",\n",
    "        \"CV ROC-AUC\":   f\"{np.mean(fold_auc):.4f} ± {np.std(fold_auc):.4f}\",\n",
    "        \"_acc_mean\":  np.mean(fold_acc),  \"_acc_std\":  np.std(fold_acc),\n",
    "        \"_f1_mean\":   np.mean(fold_f1),   \"_f1_std\":   np.std(fold_f1),\n",
    "        \"_prec_mean\": np.mean(fold_prec), \"_prec_std\": np.std(fold_prec),\n",
    "        \"_rec_mean\":  np.mean(fold_rec),  \"_rec_std\":  np.std(fold_rec),\n",
    "        \"_auc_mean\":  np.mean(fold_auc),  \"_auc_std\":  np.std(fold_auc),\n",
    "    }\n",
    "    cv_records.append(r)\n",
    "    print(f\"  → Accuracy: {r['CV Accuracy']}  |  F1: {r['CV F1']}  |  {elapsed:.0f}s\")\n",
    "cv_df = pd.DataFrame(cv_records)\n",
    "disp  = cv_df[[\"Model\", \"CV Accuracy\", \"CV F1\",\n",
    "               \"CV Precision\", \"CV Recall\", \"CV ROC-AUC\"]]\n",
    "print(\"\\n\" + \"=\" * 65)\n",
    "print(\"  SUMMARY\")\n",
    "print(\"=\" * 65)\n",
    "print(disp.to_string(index=False))\n",
    "disp.to_csv(f\"{RESULTS_DIR}/avn_nlp_cross_validation_5fold_results.csv\", index=False)\n",
    "print(f\"\\nCSV → {RESULTS_DIR}/avn_nlp_cross_validation_5fold_results.csv\")\n",
    "models    = [r[\"Model\"]     for r in cv_records]\n",
    "acc_means = [r[\"_acc_mean\"] for r in cv_records]\n",
    "acc_stds  = [r[\"_acc_std\"]  for r in cv_records]\n",
    "f1_means  = [r[\"_f1_mean\"]  for r in cv_records]\n",
    "f1_stds   = [r[\"_f1_std\"]   for r in cv_records]\n",
    "x    = np.arange(len(models))\n",
    "w    = 0.35\n",
    "COLS = [\"#4C72B0\", \"#DD8452\", \"#55A868\", \"#C44E52\", \"#8172B2\"]\n",
    "fig, ax = plt.subplots(figsize=(11, 6))\n",
    "ax.bar(x - w/2, acc_means, w, yerr=acc_stds, capsize=5, label=\"CV Accuracy\",\n",
    "       color=[c + \"99\" for c in COLS], edgecolor=\"white\",\n",
    "       error_kw={\"ecolor\": \"#333\", \"lw\": 1.5})\n",
    "ax.bar(x + w/2, f1_means,  w, yerr=f1_stds,  capsize=5, label=\"CV F1\",\n",
    "       color=COLS, edgecolor=\"white\",\n",
    "       error_kw={\"ecolor\": \"#333\", \"lw\": 1.5})\n",
    "for bars_grp, vals in [(ax.containers[0], acc_means),\n",
    "                        (ax.containers[1], f1_means)]:\n",
    "    for bar, v in zip(bars_grp, vals):\n",
    "        ax.text(bar.get_x() + bar.get_width() / 2,\n",
    "                bar.get_height() + 0.003,\n",
    "                f\"{v:.4f}\", ha=\"center\", va=\"bottom\", fontsize=7.5)\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels(models, fontsize=10)\n",
    "ax.set_ylim(0.85, 1.03)\n",
    "ax.set_ylabel(\"Score\", fontsize=12)\n",
    "ax.set_xlabel(\"Model\", fontsize=12)\n",
    "ax.set_title(\n",
    "    \"5-Fold Stratified Cross-Validation - AVN Dataset\\n\"\n",
    "    \"Linear SVM | Kernel SVM | Random Forest | LightGBM | Stacking\",\n",
    "    fontsize=13, fontweight=\"bold\", pad=14\n",
    ")\n",
    "ax.yaxis.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "ax.set_axisbelow(True)\n",
    "ax.legend(fontsize=10, framealpha=0.85)\n",
    "plt.tight_layout()\n",
    "img_path = f\"{RESULTS_DIR}/avn_nlp_cross_validation_5fold_chart.jpg\"\n",
    "fig.savefig(img_path, dpi=150, format=\"jpg\", bbox_inches=\"tight\",\n",
    "            pil_kwargs={\"quality\": 92})\n",
    "plt.show()\n",
    "plt.close(fig)\n",
    "print(f\"Chart → {img_path}\")"
   ]
