    "import os\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.metrics import roc_curve, auc, precision_recall_curve, average_precision_score\n",
    "os.makedirs(\"/content/drive/MyDrive/Phishing_Email/results\", exist_ok=True)\n",
    "roc_models = {\n",
    "    \"Logistic Regression\": (lr, X_test_final),\n",
    "    \"Random Forest\": (rf_model, X_test_final),\n",
    "    \"Linear SVM \": (svm_model, X_test_final),\n",
    "    \"LightGBM\": (lgbm_model, X_test_tfidf),\n",
    "    \"Gradient Boosting\": (gbm_model, X_test_tfidf),\n",
    "    \"AdaBoost\": (ada_model, X_test_tfidf),\n",
    "    \"Voting Classifier\": (voting_model, X_test_tfidf),\n",
    "    \"Stacking Classifier\": (stacking_model, X_test_tfidf),\n",
    "}\n",
    "curve_data = {}\n",
    "for name, (model, X_te) in roc_models.items():\n",
    "    try:\n",
    "        if hasattr(model, \"predict_proba\"):\n",
    "            scores = model.predict_proba(X_te)[:, 1]\n",
    "        elif hasattr(model, \"decision_function\"):\n",
    "            scores = model.decision_function(X_te)\n",
    "        else:\n",
    "            print(f\"Skipping {name}: no score method available\")\n",
    "            continue\n",
    "        fpr, tpr, _ = roc_curve(y_test, scores)\n",
    "        roc_auc_val = auc(fpr, tpr)\n",
    "        prec, rec, _ = precision_recall_curve(y_test, scores)\n",
    "        ap = average_precision_score(y_test, scores)\n",
    "        curve_data[name] = {\n",
    "            \"fpr\": fpr, \"tpr\": tpr, \"roc_auc\": roc_auc_val,\n",
    "            \"prec\": prec, \"rec\": rec, \"ap\": ap\n",
    "        }\n",
    "    except Exception as e:\n",
    "        print(f\"Skipping {name}: {e}\")\n",
    "plt.figure(figsize=(9, 7))\n",
