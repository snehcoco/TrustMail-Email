   "cell_type": "code",
   "source": [
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib\n",
    "matplotlib.use(\"Agg\")\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "RESULTS_DIR = \"/content/drive/MyDrive/Phishing_Email/results\"\n",
    "\n",
    "CSV_PATH = f\"{RESULTS_DIR}/avn_nlp_cross_validation_5fold_results.csv\"\n",
    "\n",
    "\n",
    "df = pd.read_csv(CSV_PATH)\n",
    "\n",
    "df = df.loc[:, ~df.columns.str.startswith(\"Unnamed:\")]\n",
    "\n",
    "\n",
    "def extract_mean(column):\n",
    "    return (\n",
    "        df[column]\n",
    "        .astype(str)\n",
    "        .str.extract(r\"([\\d.]+)\", expand=False)\n",
    "        .astype(float)\n",
    "        .to_numpy()\n",
    "    )\n",
    "\n",
    "def extract_std(column):\n",
    "    return (\n",
    "        df[column]\n",
    "        .astype(str)\n",
    "        .str.extract(r\"±\\s*([\\d.]+)\", expand=False)\n",
    "        .astype(float)\n",
    "        .to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "models = df[\"Model\"].astype(str).tolist()\n",
    "\n",
    "\n",
    "accuracy  = extract_mean(\"CV Accuracy\")\n",
    "precision = extract_mean(\"CV Precision\")\n",
    "recall    = extract_mean(\"CV Recall\")\n",
    "f1        = extract_mean(\"CV F1\")\n",
    "\n",
    "\n",
    "accuracy_std  = extract_std(\"CV Accuracy\")\n",
    "precision_std = extract_std(\"CV Precision\")\n",
    "recall_std    = extract_std(\"CV Recall\")\n",
    "f1_std        = extract_std(\"CV F1\")\n",
    "\n",
    "\n",
    "x = np.arange(len(models))\n",
    "\n",
    "bar_width = 0.19\n",
    "\n",
    "pos_accuracy  = x - 1.5 * bar_width\n",
    "pos_precision = x - 0.5 * bar_width\n",
    "pos_recall    = x + 0.5 * bar_width\n",
    "pos_f1        = x + 1.5 * bar_width\n",
    "\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 6))\n",
    "\n",
    "\n",
    "bars_accuracy = ax.bar(\n",
    "    pos_accuracy,\n",
    "    accuracy,\n",
    "    bar_width,\n",
    "    yerr=accuracy_std,\n",
    "    capsize=3,\n",
    "    label=\"Accuracy\",\n",
    "    edgecolor=\"white\",\n",
    "    linewidth=0.7,\n",
    "    error_kw={\n",
    "        \"ecolor\": \"#333333\",\n",
    "        \"elinewidth\": 1.0\n",
    "    }\n",
    ")\n",
    "\n",
    "bars_precision = ax.bar(\n",
    "    pos_precision,\n",
    "    precision,\n",
    "    bar_width,\n",
    "    yerr=precision_std,\n",
    "    capsize=3,\n",
    "    label=\"Precision\",\n",
    "    edgecolor=\"white\",\n",
    "    linewidth=0.7,\n",
    "    error_kw={\n",
    "        \"ecolor\": \"#333333\",\n",
    "        \"elinewidth\": 1.0\n",
    "    }\n",
    ")\n",
    "\n",
    "bars_recall = ax.bar(\n",
    "    pos_recall,\n",
    "    recall,\n",
    "    bar_width,\n",
    "    yerr=recall_std,\n",
    "    capsize=3,\n",
    "    label=\"Recall\",\n",
    "    edgecolor=\"white\",\n",
    "    linewidth=0.7,\n",
    "    error_kw={\n",
    "        \"ecolor\": \"#333333\",\n",
    "        \"elinewidth\": 1.0\n",
    "    }\n",
    ")\n",
    "\n",
    "bars_f1 = ax.bar(\n",
    "    pos_f1,\n",
    "    f1,\n",
    "    bar_width,\n",
    "    yerr=f1_std,\n",
    "    capsize=3,\n",
    "    label=\"F1-score\",\n",
    "    edgecolor=\"white\",\n",
    "    linewidth=0.7,\n",
    "    error_kw={\n",
    "        \"ecolor\": \"#333333\",\n",
    "        \"elinewidth\": 1.0\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "def add_labels(bars, values):\n",
    "    for bar, value in zip(bars, values):\n",
    "        ax.text(\n",
    "            bar.get_x() + bar.get_width() / 2,\n",
    "            bar.get_height() + 0.002,\n",
    "            f\"{value:.4f}\",\n",
    "            ha=\"center\",\n",
    "            va=\"bottom\",\n",
    "            fontsize=7\n",
    "        )\n",
    "\n",
    "add_labels(bars_accuracy, accuracy)\n",
    "add_labels(bars_precision, precision)\n",
    "add_labels(bars_recall, recall)\n",
    "add_labels(bars_f1, f1)\n",
    "\n",
    "\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels(\n",
    "    models,\n",
    "    fontsize=9,\n",
    "    rotation=0\n",
    ")\n",
    "\n",
    "ax.set_xlabel(\n",
    "    \"Model\",\n",
    "    fontsize=11\n",
    ")\n",
    "\n",
    "ax.set_ylabel(\n",
    "    \"Score\",\n",
    "    fontsize=11\n",
    ")\n",
    "\n",
    "\n",
    "ax.set_ylim(0.80, 1.02)\n",
    "\n",
    "ax.set_yticks(\n",
    "    np.arange(0.80, 1.025, 0.025)\n",
    ")\n",
    "\n",
    "\n",
    "ax.yaxis.grid(\n",
    "    True,\n",
    "    linestyle=\"--\",\n",
    "    linewidth=0.7,\n",
    "    alpha=0.5\n",
    ")\n",
    "\n",
    "ax.set_axisbelow(True)\n",
    "\n",
    "\n",
    "ax.set_title(\n",
    "    \"5-Fold Stratified Cross-Validation: AVN Dataset\",\n",
    "    fontsize=13,\n",
    "    fontweight=\"bold\",\n",
    "    pad=12\n",
    ")\n",
    "\n",
    "\n",
    "ax.legend(\n",
    "    loc=\"lower right\",\n",
    "    fontsize=9,\n",
    "    framealpha=0.9\n",
    ")\n",
    "\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "\n",
    "img_path = (\n",
    "    f\"{RESULTS_DIR}/\"\n",
    "    \"avnnlp_cross_validation_grouped_metrics.jpg\"\n",
    ")\n",
    "\n",
    "fig.savefig(\n",
    "    img_path,\n",
    "    dpi=300,\n",
    "    format=\"jpg\",\n",
    "    bbox_inches=\"tight\",\n",
    "    pil_kwargs={\"quality\": 95}\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "plt.close(fig)\n",
    "\n",
    "print(f\"Chart saved → {img_path}\")"
   ],
