    "import gc\n",
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "os.environ[\"PYTORCH_CUDA_ALLOC_CONF\"] = \"expandable_segments:True\"\n",
    "from transformers import (\n",
    "    DistilBertTokenizerFast,\n",
    "    DistilBertForSequenceClassification,\n",
    "    DataCollatorWithPadding,\n",
    "    Trainer,\n",
    "    TrainingArguments,\n",
    ")\n",
    "from torch.utils.data import Dataset\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score, precision_score,\n",
    "    recall_score, f1_score, classification_report,\n",
    ")\n",
    "print(\"=\" * 60)\n",
    "print(\"DISTILBERT FINE-TUNING\")\n",
    "print(\"=\" * 60)\n",
    "USE_GPU = torch.cuda.is_available()\n",
    "IS_AMPERE = USE_GPU and torch.cuda.get_device_capability()[0] >= 8\n",
    "print(f\"PyTorch version : {torch.__version__}\")\n",
    "print(f\"CUDA available  : {USE_GPU}\")\n",
    "if USE_GPU:\n",
    "    print(f\"GPU             : {torch.cuda.get_device_name(0)}\")\n",
    "    cap = torch.cuda.get_device_capability()\n",
    "    print(f\"GPU arch        : sm_{cap[0]}{cap[1]} ({'Ampere+' if IS_AMPERE else 'Volta - compile disabled'})\")\n",
    "    print(f\"VRAM            : {torch.cuda.get_device_properties(0).total_memory / 1024**3:.1f} GB\")\n",
    "    torch.backends.cuda.matmul.allow_tf32 = True\n",
    "    torch.backends.cudnn.allow_tf32 = True\n",
    "gc.collect()\n",
    "torch.cuda.empty_cache()\n",
    "torch.cuda.reset_peak_memory_stats()\n",
    "print(f\"\\ndf_train : {df_train.shape}  |  df_test : {df_test.shape}\")\n",
    "y_train_series = pd.Series(y_train).reset_index(drop=True)\n",
    "y_test_series  = pd.Series(y_test).reset_index(drop=True)\n",
    "print(\"\\nLoading tokenizer...\")\n",
    "tokenizer_bert = DistilBertTokenizerFast.from_pretrained(\"distilbert-base-uncased\")\n",
    "print(\"Tokenizer loaded.\")\n",
    "MAX_LEN = 96\n",
    "class EmailDataset(Dataset):\n",
    "    def __init__(self, texts, labels, max_length=MAX_LEN):\n",
    "        self.enc = tokenizer_bert(\n",
    "            [str(t) for t in texts],\n",
    "            truncation=True,\n",
    "            max_length=max_length,\n",
    "            padding=False,\n",
    "        )\n",
    "        self.labels = list(labels)\n",
    "    def __len__(self):\n",
    "        return len(self.labels)\n",
    "    def __getitem__(self, i):\n",
    "        item = {k: torch.tensor(v[i]) for k, v in self.enc.items()}\n",
    "        item[\"labels\"] = torch.tensor(self.labels[i], dtype=torch.long)\n",
    "        return item\n",
    "data_collator = DataCollatorWithPadding(\n",
    "    tokenizer=tokenizer_bert,\n",
    "    pad_to_multiple_of=8,\n",
    ")\n",
    "MIN_TRAIN = 20000\n",
    "print(f\"\\n{'=' * 60}\")\n",
    "print(\"PREPARING TRAINING DATA\")\n",
    "print(\"=\" * 60)\n",
    "if len(df_train) >= MIN_TRAIN:\n",
    "    sample_idx   = df_train.sample(n=MIN_TRAIN, random_state=42).index\n",
    "    train_texts  = df_train.loc[sample_idx, \"clean_text\"].tolist()\n",
    "    train_labels = y_train_series.loc[sample_idx].tolist()\n",
    "    print(f\"Sampled {MIN_TRAIN:,} from {len(df_train):,}\")\n",
    "else:\n",
    "    train_texts  = df_train[\"clean_text\"].tolist()\n",
    "    train_labels = y_train_series.tolist()\n",
    "test_texts  = df_test[\"clean_text\"].tolist()\n",
    "test_labels = y_test_series.tolist()\n",
    "from sklearn.model_selection import train_test_split as _tts\n",
    "import numpy as _np\n",
    "_tr_t, _val_t, _tr_l, _val_l = _tts(\n",
    "    train_texts, train_labels,\n",
    "    test_size=0.10, random_state=42,\n",
    "    stratify=train_labels,\n",
    ")\n",
    "print(f\"  Final train : {len(_tr_t):,}  |  Val : {len(_val_t):,}  |  Test : {len(test_texts):,}\")\n",
    "print(\"\\nTokenizing...\")\n",
    "train_dataset_bert = EmailDataset(_tr_t,    _tr_l)\n",
    "val_dataset_bert   = EmailDataset(_val_t,   _val_l)\n",
    "test_dataset_bert  = EmailDataset(test_texts, test_labels)\n",
    "print(\"Done.\")\n",
    "print(\"\\nLoading DistilBERT model...\")\n",
    "model_bert = DistilBertForSequenceClassification.from_pretrained(\n",
    "    \"distilbert-base-uncased\", num_labels=2\n",
    ")\n",
    "model_bert.gradient_checkpointing_enable()\n",
    "print(f\"Model loaded. Gradient checkpointing: enabled\")\n",
    "print(f\"VRAM after model load: {torch.cuda.memory_allocated()/1024**3:.2f} GB\")\n",
    "OUTPUT_DIR = \"/content/drive/MyDrive/Phishing_Email/models/distilbert\"\n",
    "args = TrainingArguments(\n",
    "    output_dir=OUTPUT_DIR,\n",
    "    num_train_epochs=3,\n",
    "    per_device_train_batch_size=16,\n",
    "    per_device_eval_batch_size=32,\n",
    "    gradient_accumulation_steps=2,\n",
    "    warmup_steps=187,\n",
    "    weight_decay=0.01,\n",
    "    learning_rate=2e-5,\n",
    "    eval_strategy=\"epoch\",\n",
    "    save_strategy=\"epoch\",\n",
    "    load_best_model_at_end=True,\n",
    "    metric_for_best_model=\"eval_loss\",\n",
    "    greater_is_better=False,\n",
    "    logging_steps=50,\n",
    "    fp16=USE_GPU,\n",
    "    torch_compile=False,\n",
    "    optim=\"adamw_torch\",\n",
    "    dataloader_num_workers=0,\n",
    "    dataloader_pin_memory=USE_GPU,\n",
    "    dataloader_persistent_workers=False,\n",
    "    remove_unused_columns=False,\n",
    "    report_to=\"none\",\n",
    "    seed=42,\n",
    ")\n",
    "def compute_metrics(eval_pred):\n",
    "    logits, labels = eval_pred\n",
    "    preds = np.argmax(logits, axis=-1)\n",
    "    return {\n",
    "        \"accuracy\":  accuracy_score(labels, preds),\n",
    "        \"precision\": precision_score(labels, preds, zero_division=0),\n",
    "        \"recall\":    recall_score(labels, preds, zero_division=0),\n",
    "        \"f1\":        f1_score(labels, preds, zero_division=0),\n",
    "    }\n",
    "trainer_bert = Trainer(\n",
    "    model=model_bert,\n",
    "    args=args,\n",
    "    train_dataset=train_dataset_bert,\n",
    "    eval_dataset=val_dataset_bert,\n",
    "    data_collator=data_collator,\n",
    "    compute_metrics=compute_metrics,\n",
    ")\n",
    "print(f\"\\n{'=' * 60}\")\n",
    "print(\"STARTING TRAINING\")\n",
    "print(\"=\" * 60)\n",
    "trainer_bert.train()\n",
    "print(f\"\\n{'=' * 60}\")\n",
    "print(\"FINAL EVALUATION (test set)\")\n",
    "print(\"=\" * 60)\n",
    "bert_preds  = trainer_bert.predict(test_dataset_bert)\n",
    "bert_labels = bert_preds.predictions.argmax(-1)\n",
    "acc  = accuracy_score(test_labels,  bert_labels)\n",
    "prec = precision_score(test_labels, bert_labels, zero_division=0)\n",
    "rec  = recall_score(test_labels,    bert_labels, zero_division=0)\n",
    "f1   = f1_score(test_labels,        bert_labels, zero_division=0)\n",
    "print(f\"\\n  Accuracy  : {acc:.4f}\")\n",
    "print(f\"  Precision : {prec:.4f}\")\n",
    "print(f\"  Recall    : {rec:.4f}\")\n",
    "print(f\"  F1 Score  : {f1:.4f}\")\n",
    "print(\"\\nClassification Report:\")\n",
    "print(classification_report(test_labels, bert_labels,\n",
    "      target_names=[\"Legitimate\", \"Phishing\"], zero_division=0))\n",
    "bert_save_dir = \"/content/drive/MyDrive/Phishing_Email/models/distilbert_saved\"\n",
    "os.makedirs(bert_save_dir, exist_ok=True)\n",
    "model_bert.save_pretrained(bert_save_dir)\n",
    "tokenizer_bert.save_pretrained(bert_save_dir)\n",
    "print(f\"\\nDistilBERT saved → {bert_save_dir}\")"
   ]
  },
