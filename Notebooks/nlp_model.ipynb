    "import pandas as pd\n",
    "import numpy as np\n",
    "print(\"\\nDataset Info:\")\n",
    "print(df.info())\n",
    "print(\"\\nMissing Values:\")\n",
    "missing = df.isnull().sum()\n",
    "missing = missing[missing > 0]\n",
    "print(missing if len(missing) > 0 else \"No missing values\")\n",
    "duplicates = df.duplicated().sum()\n",
    "print(f\"\\nDuplicate Rows: {duplicates}\")\n",
    "if duplicates > 0:\n",
    "    df = df.drop_duplicates()\n",
    "    print(\"Duplicates removed. New shape:\", df.shape)\n",
    "print(\"\\nData Types:\")\n",
    "print(df.dtypes)\n",
    "TARGET_COL = 'label'\n",
    "print(\"\\nTarget Distribution:\")\n",
    "print(df[TARGET_COL].value_counts())\n",
    "print(\"\\nTarget Percentage:\")\n",
    "print(df[TARGET_COL].value_counts(normalize=True) * 100)\n",
    "constant_cols = [col for col in df.columns if df[col].nunique() <= 1]\n",
    "print(\"\\nConstant Columns:\", constant_cols)\n",
    "df.drop(columns=constant_cols, inplace=True)\n",
    "print(\"\\nNumerical Summary:\")\n",
    "num_cols = df.select_dtypes(include=[np.number]).columns\n",
    "print(df[num_cols].describe())\n",
    "inf_cols = df[num_cols].isin([np.inf, -np.inf]).sum()\n",
    "inf_cols = inf_cols[inf_cols > 0]\n",
    "print(\"\\nInfinite Values:\")\n",
    "print(inf_cols if len(inf_cols) > 0 else \"No infinite values\")\n",
    "df.replace([np.inf, -np.inf], np.nan, inplace=True)\n",
    "df.fillna(0, inplace=True)\n",
    "print(\"\\nChecking Highly Correlated Features (>0.95)\")\n",
    "corr_matrix = df[num_cols].corr().abs()\n",
    "high_corr = [\n",
    "    (col1, col2)\n",
    "    for col1 in corr_matrix.columns\n",
    "    for col2 in corr_matrix.columns\n",
    "    if col1 != col2 and corr_matrix.loc[col1, col2] > 0.95\n",
    "]\n",
    "print(\"Highly correlated pairs:\", high_corr[:10])\n",
    "if TARGET_COL in num_cols:\n",
    "    leakage = df[num_cols].corr()[TARGET_COL].abs().sort_values(ascending=False)\n",
    "    print(\"\\n Feature vs Target Correlation:\")\n",
    "    print(leakage.head(10))\n",
    "print(\"\\nFinal Shape:\", df.shape)\n",
    "df.to_csv('/content/drive/MyDrive/Phishing_Email/final_dataset/nlp_final_features_reduced.csv', index=False)\n",
    "print(\"\\nClean dataset saved!\")"
   ]
