   },
   "source": [
    "### 12b. Restore State for Embedding Section"
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "import joblib, pandas as pd\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "df = pd.read_csv(\"/content/drive/MyDrive/Phishing_Email/final_dataset/nlp_final_features_reduced.csv\")\n",
    "\n",
    "numerical_features = [\n",
    "    \"word_count\", \"avg_word_length\", \"uppercase_ratio\", \"url_like_count\",\n",
    "    \"text_entropy\", \"action_density\", \"has_attachment\",\n",
    "    \"repeated_char_patterns\", \"writing_error_total\"\n",
    "]\n",
    "\n",
    "X_text = df[\"clean_text\"].fillna(\"\")\n",
    "y      = df[\"label\"]\n",
    "\n",
    "X_train_text, X_test_text, y_train, y_test = train_test_split(\n",
    "    X_text, y, test_size=0.2, random_state=42, stratify=y\n",
    ")\n",
    "\n",
    "df_train = X_train_text.reset_index(drop=True).to_frame()\n",
    "df_test  = X_test_text.reset_index(drop=True).to_frame()\n",
    "y_train  = y_train.reset_index(drop=True)\n",
    "y_test   = y_test.reset_index(drop=True)\n",
    "\n",
    "tfidf = joblib.load(\"/content/drive/MyDrive/Phishing_Email/nlp_features/tfidf_features.pkl\")\n",
    "X_train_tfidf = tfidf.transform(df_train[\"clean_text\"].astype(str))\n",
    "X_test_tfidf  = tfidf.transform(df_test[\"clean_text\"].astype(str))\n",
    "\n",
    "print(\"State restored. Ready to run sentence embeddings cell.\")"
   ],
   "metadata": {
