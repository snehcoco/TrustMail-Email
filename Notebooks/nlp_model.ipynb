    "import gc, tensorflow as tf\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import (TextVectorization, Embedding, Conv1D,\n",
    "    MaxPooling1D, Bidirectional, LSTM, Dropout, Dense)\n",
    "from tensorflow.keras.callbacks import EarlyStopping\n",
    "CHAR_MAX_LEN   = 300\n",
    "CHAR_EMBED_DIM = 64\n",
    "CHAR_VOCAB     = 200\n",
    "char_vectorizer = TextVectorization(\n",
    "    max_tokens=CHAR_VOCAB,\n",
    "    output_mode=\"int\",\n",
    "    output_sequence_length=CHAR_MAX_LEN,\n",
    "    split=\"character\",\n",
    "    standardize=None,\n",
    ")\n",
    "char_vectorizer.adapt(tf.constant(train_texts))\n",
    "X_train_char_pad = char_vectorizer(tf.constant(train_texts)).numpy()\n",
    "X_test_char_pad  = char_vectorizer(tf.constant(test_texts)).numpy()\n",
    "char_vocab_size  = len(char_vectorizer.get_vocabulary())\n",
    "print(f\"Char vocab size : {char_vocab_size}\")\n",
    "print(f\"Train shape     : {X_train_char_pad.shape}\")\n",
    "charcnn_bilstm_model = Sequential([\n",
    "    Embedding(char_vocab_size, CHAR_EMBED_DIM, input_length=CHAR_MAX_LEN),\n",
    "    Conv1D(128, kernel_size=7, activation=\"relu\"),\n",
    "    MaxPooling1D(pool_size=3),\n",
    "    Conv1D(128, kernel_size=5, activation=\"relu\"),\n",
    "    MaxPooling1D(pool_size=3),\n",
    "    Bidirectional(LSTM(64, return_sequences=False)),\n",
    "    Dropout(0.5),\n",
    "    Dense(64, activation=\"relu\"),\n",
    "    Dropout(0.3),\n",
    "    Dense(1, activation=\"sigmoid\"),\n",
    "])\n",
    "charcnn_bilstm_model.compile(optimizer=\"adam\", loss=\"binary_crossentropy\", metrics=[\"accuracy\"])\n",
    "charcnn_bilstm_model.summary()\n",
    "es = EarlyStopping(monitor=\"val_loss\", patience=1, restore_best_weights=True)\n",
    "history_charcnn = charcnn_bilstm_model.fit(\n",
    "    X_train_char_pad, y_train_arr,\n",
    "    validation_split=0.1,\n",
    "    epochs=3,\n",
    "    batch_size=128,\n",
    "    callbacks=[es],\n",
    "    verbose=1,\n",
    ")\n",
    "evaluate_keras(\"CharCNN-BiLSTM\", charcnn_bilstm_model, X_test_char_pad, y_test_arr)\n",
    "del X_train_char_pad, X_test_char_pad\n",
    "gc.collect()"
   ]
  },
