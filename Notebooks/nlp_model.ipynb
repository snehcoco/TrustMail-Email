    "### 5d. Entropy & Action Density Features"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "LnIDirHsMpsW"
   },
   "outputs": [],
   "source": [
    "import math\n",
    "\n",
    "def text_entropy(text):\n",
    "    text = str(text)\n",
    "    freq = Counter(text)\n",
    "    probs = [f / len(text) for f in freq.values()]\n",
    "    return -sum(p * math.log2(p) for p in probs)\n",
    "\n",
    "df['text_entropy'] = df['body'].apply(text_entropy)"
   ]
  },
