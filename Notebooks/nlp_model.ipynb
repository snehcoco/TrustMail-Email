    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.svm import LinearSVC\n",
    "from sklearn.calibration import CalibratedClassifierCV, calibration_curve\n",
    "from sklearn.metrics import (brier_score_loss, accuracy_score,\n",
    "                             precision_score, recall_score,\n",
    "                             f1_score, roc_auc_score)\n",
    "raw_scores       = svm_model.decision_function(X_test_final)\n",
    "raw_pseudo_prob  = 1.0 / (1.0 + np.exp(-raw_scores))\n",
    "brier_uncalibrated = brier_score_loss(y_test, raw_pseudo_prob)\n",
    "svm_base = LinearSVC(\n",
    "    C=1.0,\n",
    "    class_weight=\"balanced\",\n",
    "    random_state=42,\n",
    "    max_iter=10000\n",
    ")\n",
    "svm_calibrated = CalibratedClassifierCV(svm_base, method=\"sigmoid\", cv=5)\n",
    "svm_calibrated.fit(X_train_final, y_train)\n",
    "pred_svm_calibrated = svm_calibrated.predict(X_test_final)\n",
    "prob_svm_calibrated = svm_calibrated.predict_proba(X_test_final)[:, 1]\n",
    "brier_calibrated = brier_score_loss(y_test, prob_svm_calibrated)\n",
    "accuracy  = accuracy_score(y_test,  pred_svm_calibrated)\n",
    "precision = precision_score(y_test, pred_svm_calibrated, zero_division=0)\n",
    "recall    = recall_score(y_test,    pred_svm_calibrated, zero_division=0)\n",
    "f1        = f1_score(y_test,        pred_svm_calibrated, zero_division=0)\n",
    "roc_auc   = roc_auc_score(y_test,   prob_svm_calibrated)\n",
    "print(\"Platt-Scaled Linear SVM - Test Set Performance\")\n",
    "print(f\"  Accuracy  : {accuracy:.4f}\")\n",
    "print(f\"  Precision : {precision:.4f}\")\n",
    "print(f\"  Recall    : {recall:.4f}\")\n",
    "print(f\"  F1 Score  : {f1:.4f}\")\n",
    "print(f\"  ROC-AUC   : {roc_auc:.4f}\")\n",
    "print()\n",
    "print(\"─\" * 60)\n",
    "print(\"BRIER SCORE SUMMARY (cite in paper Section VII-F)\")\n",
    "print(\"─\" * 60)\n",
    "print(f\"  Uncalibrated (sigmoid of raw decision function): {brier_uncalibrated:.4f}\")\n",
    "print(f\"  Platt-scaled (calibrated probabilities)        : {brier_calibrated:.4f}\")\n",
    "print()\n",
    "print(\"  Interpretation:\")\n",
    "print(\"  'Uncalibrated' = sigmoid(f(x)), where f(x) is the LinearSVC\")\n",
    "print(\"  decision function. This is NOT a calibrated probability.\")\n",
    "print(\"  Platt scaling learns A, B on training data (5-fold CV) so that\")\n",
    "print(\"  P_cal(x) = 1 / (1 + exp(A·f(x) + B)).\")\n",
    "print(\"  Lower Brier score = better-calibrated probabilities.\")\n",
    "print(\"─\" * 60)\n",
    "frac_pos_raw, mean_pred_raw = calibration_curve(y_test, raw_pseudo_prob,    n_bins=10)\n",
    "frac_pos_cal, mean_pred_cal = calibration_curve(y_test, prob_svm_calibrated, n_bins=10)\n",
    "plt.figure(figsize=(6, 6))\n",
    "plt.plot([0, 1], [0, 1], \"k--\", label=\"Perfectly calibrated\")\n",
    "plt.plot(mean_pred_raw, frac_pos_raw, \"o-\",\n",
    "         label=f\"Uncalibrated sigmoid (Brier={brier_uncalibrated:.4f})\")\n",
    "plt.plot(mean_pred_cal, frac_pos_cal, \"o-\",\n",
    "         label=f\"Platt-scaled (Brier={brier_calibrated:.4f})\")\n",
    "plt.xlabel(\"Mean predicted probability\")\n",
    "plt.ylabel(\"Fraction of positives\")\n",
    "plt.title(\"Reliability Diagram - Linear SVM Platt Scaling\")\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(\n",
    "    \"/content/drive/MyDrive/Phishing_Email/results/svm_platt_calibration_curve.png\",\n",
    "    dpi=150\n",
    ")\n",
    "plt.show()\n",
    "import joblib\n",
    "joblib.dump(\n",
    "    svm_calibrated,\n",
    "    \"/content/drive/MyDrive/Phishing_Email/models/nlp_svm_linear_calibrated_platt.pkl\"\n",
    ")\n",
    "print(\"\\nCalibrated Linear SVM saved.\")"
