   "source": [
    "\n",
    "from tensorflow.keras.models import Model\n",
    "from tensorflow.keras.layers import (\n",
    "    Input,\n",
    "    Embedding,\n",
    "    Conv1D,\n",
    "    GlobalMaxPooling1D,\n",
    "    Dropout,\n",
    "    Dense,\n",
    "    Concatenate\n",
    ")\n",
    "from tensorflow.keras.callbacks import EarlyStopping\n",
    "\n",
    "def build_textcnn(vocab_size, embed_dim=EMBED_DIM, max_len=MAX_LEN):\n",
    "    inp = Input(shape=(max_len,))\n",
    "    emb = Embedding(\n",
    "        vocab_size,\n",
    "        embed_dim,\n",
    "        input_length=max_len\n",
    "    )(inp)\n",
    "\n",
    "    convs = []\n",
    "\n",
    "    for k in (3, 4, 5):\n",
    "        c = Conv1D(\n",
    "            filters=128,\n",
    "            kernel_size=k,\n",
    "            activation=\"relu\"\n",
    "        )(emb)\n",
    "        c = GlobalMaxPooling1D()(c)\n",
    "        convs.append(c)\n",
    "\n",
    "    x = Concatenate()(convs)\n",
    "    x = Dropout(0.5)(x)\n",
    "    x = Dense(64, activation=\"relu\")(x)\n",
    "    x = Dropout(0.3)(x)\n",
    "    out = Dense(1, activation=\"sigmoid\")(x)\n",
    "\n",
    "    model = Model(inp, out)\n",
    "\n",
    "    model.compile(\n",
    "        optimizer=\"adam\",\n",
    "        loss=\"binary_crossentropy\",\n",
    "        metrics=[\"accuracy\"]\n",
    "    )\n",
    "\n",
    "    return model\n",
    "\n",
    "\n",
    "textcnn_model = build_textcnn(vocab_size)\n",
    "textcnn_model.summary()\n",
    "\n",
    "es = EarlyStopping(\n",
    "    monitor=\"val_loss\",\n",
    "    patience=2,\n",
    "    restore_best_weights=True\n",
    ")\n",
    "\n",
    "history_textcnn = textcnn_model.fit(\n",
    "    X_train_pad,\n",
    "    y_train_arr,\n",
    "    validation_split=0.1,\n",
    "    epochs=10,\n",
    "    batch_size=64,\n",
    "    callbacks=[es],\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "evaluate_keras(\n",
    "    \"TextCNN\",\n",
    "    textcnn_model,\n",
    "    X_test_pad,\n",
    "    y_test_arr\n",
    ")"
   ]
  },
