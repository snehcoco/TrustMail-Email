   "source": [
    "import language_tool_python\n",
    "import pandas as pd\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "tool = language_tool_python.LanguageTool('en-US')\n",
    "\n",
    "def should_skip(text):\n",
    "    if len(text) < 20:\n",
    "        return True\n",
    "    if text.isalpha():\n",
    "        return True\n",
    "    return False\n",
    "\n",
    "def grammar_count(text):\n",
    "    text = str(text)[:100]\n",
    "    if should_skip(text):\n",
    "        return 0\n",
    "    try:\n",
    "        matches = tool.check(text)\n",
    "        return len(matches)\n",
    "    except Exception:\n",
    "        return 0\n",
    "\n",
    "def run_grammar_check(df, column='body'):\n",
    "    texts = df[column].fillna(\"\").astype(str).tolist()\n",
    "    results = []\n",
    "    for text in tqdm(texts, desc=\"Grammar check\", unit=\"email\", dynamic_ncols=True):\n",
    "        results.append(grammar_count(text))\n",
    "    return results\n",
    "\n",
    "df['grammar_error_count'] = run_grammar_check(df)\n",
    "print(f\"Grammar check complete. Non-zero errors: {(df['grammar_error_count'] > 0).sum()}\")"
   ]
  },
