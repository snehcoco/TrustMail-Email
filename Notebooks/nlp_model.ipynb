    "from sentence_transformers import SentenceTransformer\n",
    "from sklearn.svm import LinearSVC\n",
    "from scipy.sparse import hstack as sparse_hstack, csr_matrix\n",
    "import numpy as np\n",
    "print(\"Loading all-MiniLM-L6-v2...\")\n",
    "minilm_model = SentenceTransformer(\"all-MiniLM-L6-v2\")\n",
    "print(\"  Model loaded.\")\n",
    "print(\"Encoding training texts...\")\n",
    "X_train_minilm = minilm_model.encode(\n",
    "    df_train[\"clean_text\"].astype(str).tolist(),\n",
    "    batch_size=64,\n",
    "    show_progress_bar=True,\n",
    "    normalize_embeddings=True,\n",
    ")\n",
    "print(f\"  Train embeddings: {X_train_minilm.shape}\")\n",
    "print(\"Encoding test texts...\")\n",
    "X_test_minilm = minilm_model.encode(\n",
    "    df_test[\"clean_text\"].astype(str).tolist(),\n",
    "    batch_size=64,\n",
    "    show_progress_bar=True,\n",
    "    normalize_embeddings=True,\n",
    ")\n",
    "print(f\"  Test embeddings : {X_test_minilm.shape}\")\n",
    "X_train_hybrid = sparse_hstack([X_train_tfidf, csr_matrix(X_train_minilm)])\n",
    "X_test_hybrid  = sparse_hstack([X_test_tfidf,  csr_matrix(X_test_minilm)])\n",
    "print(f\"  Hybrid matrix   : {X_train_hybrid.shape}\")\n",
    "svm_hybrid = LinearSVC(C=1.0, class_weight=\"balanced\", max_iter=10000)\n",
    "svm_hybrid.fit(X_train_hybrid, y_train)\n",
    "pred_hybrid = svm_hybrid.predict(X_test_hybrid)\n",
    "evaluate(\"LinearSVM + TF-IDF + MiniLM (all-MiniLM-L6-v2)\", y_test, pred_hybrid, None)"
   ]
  },
