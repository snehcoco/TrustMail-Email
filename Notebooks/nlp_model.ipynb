   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from gensim.models import Word2Vec\n",
    "from gensim.models.doc2vec import Doc2Vec, TaggedDocument\n",
    "from sklearn.svm import LinearSVC\n",
    "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, roc_auc_score\n",
    "\n",
    "train_tokens = df_train[\"clean_text\"].astype(str).apply(str.split).tolist()\n",
    "test_tokens  = df_test[\"clean_text\"].astype(str).apply(str.split).tolist()\n",
    "\n",
    "def vec_metrics(name, y_true, y_pred, y_prob=None):\n",
    "    row = {\n",
    "        \"Vectorization\": name,\n",
    "        \"Accuracy\": accuracy_score(y_true, y_pred),\n",
    "        \"Precision\": precision_score(y_true, y_pred, zero_division=0),\n",
    "        \"Recall\": recall_score(y_true, y_pred, zero_division=0),\n",
    "        \"F1\": f1_score(y_true, y_pred, zero_division=0),\n",
    "        \"ROC_AUC\": roc_auc_score(y_true, y_prob) if y_prob is not None else np.nan,\n",
    "    }\n",
    "    print(f\"{name}: Acc={row['Accuracy']:.4f}  P={row['Precision']:.4f}  \"\n",
    "          f\"R={row['Recall']:.4f}  F1={row['F1']:.4f}  AUC={row['ROC_AUC']:.4f}\")\n",
    "    return row\n",
    "\n",
    "comparison_rows = []\n",
    "\n",
    "pred_tfidf = svm_model.predict(X_test_final)\n",
    "prob_tfidf = svm_calibrated.predict_proba(X_test_final)[:, 1] if \"svm_calibrated\" in dir() else None\n",
    "comparison_rows.append(vec_metrics(\"TF-IDF (+ numerical)\", y_test, pred_tfidf, prob_tfidf))\n",
    "\n",
    "w2v_model = Word2Vec(\n",
    "    sentences=train_tokens,\n",
    "    vector_size=300,\n",
    "    window=5,\n",
    "    min_count=2,\n",
    "    workers=4,\n",
    "    sg=1,\n",
    "    seed=42\n",
    ")\n",
    "\n",
    "def avg_word2vec(tokens_list, model, dim=300):\n",
    "    vectors = []\n",
    "    for tokens in tokens_list:\n",
    "        word_vecs = [model.wv[t] for t in tokens if t in model.wv]\n",
    "        vectors.append(np.mean(word_vecs, axis=0) if word_vecs else np.zeros(dim))\n",
    "    return np.vstack(vectors)\n",
    "\n",
    "X_train_w2v = avg_word2vec(train_tokens, w2v_model)\n",
    "X_test_w2v  = avg_word2vec(test_tokens, w2v_model)\n",
    "\n",
    "svm_w2v = LinearSVC(C=1.0, class_weight=\"balanced\", max_iter=10000)\n",
    "svm_w2v.fit(X_train_w2v, y_train)\n",
    "pred_w2v = svm_w2v.predict(X_test_w2v)\n",
    "comparison_rows.append(vec_metrics(\"Word2Vec (avg, skip-gram)\", y_test, pred_w2v, None))\n",
    "\n",
    "train_tagged = [TaggedDocument(words=toks, tags=[str(i)]) for i, toks in enumerate(train_tokens)]\n",
    "\n",
    "d2v_model = Doc2Vec(\n",
    "    train_tagged,\n",
    "    vector_size=300,\n",
    "    window=5,\n",
    "    min_count=2,\n",
    "    workers=4,\n",
    "    dm=1,\n",
    "    epochs=40,\n",
    "    seed=42\n",
    ")\n",
    "\n",
    "X_train_d2v = np.vstack([d2v_model.dv[str(i)] for i in range(len(train_tokens))])\n",
    "X_test_d2v  = np.vstack([d2v_model.infer_vector(toks) for toks in test_tokens])\n",
    "\n",
    "svm_d2v = LinearSVC(C=1.0, class_weight=\"balanced\", max_iter=10000)\n",
    "svm_d2v.fit(X_train_d2v, y_train)\n",
    "pred_d2v = svm_d2v.predict(X_test_d2v)\n",
    "comparison_rows.append(vec_metrics(\"Doc2Vec (PV-DM)\", y_test, pred_d2v, None))\n",
    "\n",
    "\n",
    "from sentence_transformers import SentenceTransformer\n",
    "from sklearn.svm import LinearSVC\n",
    "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\n",
    "import numpy as np, os, joblib\n",
    "\n",
    "BASE  = \"/content/drive/MyDrive/Phishing_Email\"\n",
    "MODEL = f\"{BASE}/models\"\n",
    "\n",
    "print(\"Loading all-MiniLM-L6-v2...\")\n",
    "minilm_model = SentenceTransformer(\"all-MiniLM-L6-v2\")\n",
    "\n",
    "train_texts = df_train[\"clean_text\"].astype(str).tolist()\n",
    "test_texts  = df_test[\"clean_text\"].astype(str).tolist()\n",
    "\n",
    "print(f\"Encoding {len(train_texts):,} training emails on GPU...\")\n",
    "X_train_minilm = minilm_model.encode(\n",
    "    train_texts, batch_size=128,\n",
    "    show_progress_bar=True,\n",
    "    normalize_embeddings=True, device=\"cuda\"\n",
    ")\n",
    "print(f\"Encoding {len(test_texts):,} test emails on GPU...\")\n",
    "X_test_minilm = minilm_model.encode(\n",
    "    test_texts, batch_size=128,\n",
    "    show_progress_bar=True,\n",
    "    normalize_embeddings=True, device=\"cuda\"\n",
    ")\n",
    "print(f\"Train: {X_train_minilm.shape}  Test: {X_test_minilm.shape}\")\n",
    "\n",
    "svm_minilm = LinearSVC(C=1.0, class_weight=\"balanced\", max_iter=10000, random_state=42)\n",
    "svm_minilm.fit(X_train_minilm, y_train)\n",
    "pred_minilm = svm_minilm.predict(X_test_minilm)\n",
    "\n",
    "print()\n",
    "print(\"=\" * 55)\n",
    "print(\"SVM + MiniLM (all-MiniLM-L6-v2) - VERIFIED\")\n",
    "print(\"=\" * 55)\n",
    "print(f\"Accuracy  : {accuracy_score(y_test, pred_minilm):.4f}\")\n",
    "print(f\"Precision : {precision_score(y_test, pred_minilm, zero_division=0):.4f}\")\n",
    "print(f\"Recall    : {recall_score(y_test, pred_minilm, zero_division=0):.4f}\")\n",
    "print(f\"F1 Score  : {f1_score(y_test, pred_minilm, zero_division=0):.4f}\")\n",
    "\n",
    "comparison_rows.append(vec_metrics(\"SVM + MiniLM (all-MiniLM-L6-v2)\", y_test, pred_minilm, None))\n",
    "\n",
    "os.makedirs(f\"{BASE}/nlp_features\", exist_ok=True)\n",
    "np.save(f\"{BASE}/nlp_features/train_minilm_embeddings.npy\", X_train_minilm)\n",
    "np.save(f\"{BASE}/nlp_features/test_minilm_embeddings.npy\",  X_test_minilm)\n",
    "joblib.dump(svm_minilm, f\"{MODEL}/svm_minilm_model.pkl\")\n",
    "print(\"Saved to Drive.\")\n",
    "\n",
    "import joblib as _jl\n",
    "_jl.dump(w2v_model, f\"{MODEL}/word2vec_model.pkl\")\n",
    "d2v_model.save(f\"{MODEL}/doc2vec_model.pkl\")\n",
    "print(\"Word2Vec and Doc2Vec models saved.\")\n",
    "\n",
    "vectorization_comparison_df = pd.DataFrame(comparison_rows)\n",
    "print(\"\\n\" + \"=\" * 65)\n",
    "print(\"FULL VECTORIZATION COMPARISON TABLE (cite in paper Section IV-B)\")\n",
    "print(\"=\" * 65)\n",
    "print(vectorization_comparison_df.to_string(index=False))\n",
    "\n",
    "import os\n",
    "os.makedirs(\"/content/drive/MyDrive/Phishing_Email/results\", exist_ok=True)\n",
    "vectorization_comparison_df.to_csv(\n",
    "    \"/content/drive/MyDrive/Phishing_Email/results/vectorization_comparison.csv\",\n",
    "    index=False\n",
    ")\n",
    "print(\"\\nFull comparison table saved → results/vectorization_comparison.csv\")\n"
   ]
