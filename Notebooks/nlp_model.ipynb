    "    roc_auc_score\n",
    ")\n",
    "os.makedirs(\"/content/drive/MyDrive/Phishing_Email/results\", exist_ok=True)\n",
    "def metrics_row(component, variant, y_true, y_pred, y_prob=None):\n",
    "    return {\n",
    "        \"Component\": component,\n",
    "        \"Variant\": variant,\n",
    "        \"Accuracy\": accuracy_score(y_true, y_pred),\n",
    "        \"Precision\": precision_score(y_true, y_pred, zero_division=0),\n",
    "        \"Recall\": recall_score(y_true, y_pred, zero_division=0),\n",
    "        \"F1\": f1_score(y_true, y_pred, zero_division=0),\n",
    "        \"ROC_AUC\": roc_auc_score(y_true, y_prob) if y_prob is not None else np.nan,\n",
    "    }\n",
    "ablation_rows = []\n",
    "rf_tfidf_only = RandomForestClassifier(\n",
    "    n_estimators=100,\n",
    "    random_state=42,\n",
    "    n_jobs=-1,\n",
    "    class_weight=\"balanced\"\n",
    ")\n",
    "rf_tfidf_only.fit(X_train_tfidf, y_train)\n",
    "pred_rf_tfidf_only = rf_tfidf_only.predict(X_test_tfidf)\n",
    "prob_rf_tfidf_only = rf_tfidf_only.predict_proba(X_test_tfidf)[:, 1]\n",
    "ablation_rows.append(metrics_row(\n",
    "    \"Feature Set (Random Forest)\",\n",
    "    \"TF-IDF only\",\n",
    "    y_test,\n",
    "    pred_rf_tfidf_only,\n",
    "    prob_rf_tfidf_only\n",
    "))\n",
    "ablation_rows.append(metrics_row(\n",
    "    \"Feature Set (Random Forest)\",\n",
    "    \"TF-IDF + Numerical Features\",\n",
    "    y_test,\n",
    "    pred_rf,\n",
    "    prob_rf\n",
    "))\n",
    "ablation_rows.append(metrics_row(\n",
    "    \"Ensembling\",\n",
    "    \"Best Single Model (LightGBM)\",\n",
    "    y_test,\n",
    "    pred_lgbm,\n",
