    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy.stats import chi2\n",
    "from sklearn.metrics import f1_score\n",
    "pred_rf_tfidf   = rf_tfidf_only.predict(X_test_tfidf)\n",
    "pred_rf_full    = pred_rf\n",
    "ablation_pairs = [\n",
    "    (\"Feature: TF-IDF only\",            \"Feature: TF-IDF + Numerical (RF)\", pred_rf_tfidf,  pred_rf_full),\n",
    "    (\"Ensemble: Best Single (LightGBM)\", \"Ensemble: Voting Classifier\",      pred_lgbm,      pred_voting),\n",
    "    (\"Ensemble: Best Single (LightGBM)\", \"Ensemble: Stacking Classifier\",    pred_lgbm,      pred_stacking),\n",
    "    (\"Ensemble: Voting Classifier\",      \"Ensemble: Stacking Classifier\",    pred_voting,    pred_stacking),\n",
    "]\n",
    "sig_rows = []\n",
    "for label_a, label_b, pred_a, pred_b in ablation_pairs:\n",
    "    stat, p, b, c = mcnemar_test(y_test, pred_a, pred_b)\n",
    "    f1_a = f1_score(y_test, pred_a, zero_division=0)\n",
    "    f1_b = f1_score(y_test, pred_b, zero_division=0)\n",
    "    sig_rows.append({\n",
    "        \"Condition A\":     label_a,\n",
    "        \"F1(A)\":           round(f1_a, 4),\n",
    "        \"Condition B\":     label_b,\n",
    "        \"F1(B)\":           round(f1_b, 4),\n",
    "        \"ΔF1 (B − A)\":    round(f1_b - f1_a, 4),\n",
    "        \"Chi²\":            round(stat, 4),\n",
    "        \"p-value\":         round(p, 6),\n",
    "        \"Significant\":     \"Yes\" if p < 0.05 else \"No\",\n",
    "    })\n",
    "sig_df = pd.DataFrame(sig_rows)\n",
    "print(\"Ablation Significance Testing (McNemar, p < 0.05 → drop/gain is real)\\n\")\n",
    "print(sig_df.to_string(index=False))\n",
    "sig_df.to_csv(\n",
    "    \"/content/drive/MyDrive/Phishing_Email/results/ablation_significance.csv\",\n",
    "    index=False\n",
    ")\n",
    "print(\"\\nSaved → ablation_significance.csv\")"
