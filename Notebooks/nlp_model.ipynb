    "from spellchecker import SpellChecker\n",
    "\n",
    "spell = SpellChecker()\n",
    "\n",
    "def grammar_proxy(text):\n",
    "    text = str(text).lower()[:150]\n",
    "    words = text.split()\n",
    "    if len(words) < 5:\n",
    "        return 0\n",
    "    misspelled = spell.unknown(words)\n",
    "    return len(misspelled)\n",
    "\n",
    "df['spelling_error_count'] = df['body'].fillna(\"\").apply(grammar_proxy)\n",
    "print(f\"Spelling error count computed. Non-zero: {(df['spelling_error_count'] > 0).sum()}\")\n",
    "print(df['spelling_error_count'].describe())"
   ]
  },
