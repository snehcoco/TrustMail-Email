    "\n",
    "numerical_features = [\n",
    "    \"word_count\",\n",
    "    \"avg_word_length\",\n",
    "    \"uppercase_ratio\",\n",
    "    \"url_like_count\",\n",
    "    \"text_entropy\",\n",
    "    \"action_density\",\n",
    "    \"has_attachment\",\n",
    "    \"repeated_char_patterns\",\n",
    "    \"writing_error_total\"\n",
    "]\n",
    "\n",
    "X_text = df[\"clean_text\"].fillna(\"\")\n",
    "X_num  = df[numerical_features]\n",
    "y = df[\"label\"]\n",
    "\n",
    "\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "X_train_text, X_test_text, X_train_num, X_test_num, y_train, y_test = train_test_split(\n",
    "    X_text,\n",
    "    X_num,\n",
    "    y,\n",
    "    test_size=0.2,\n",
    "    random_state=42,\n",
    "    stratify=y\n",
    ")"
