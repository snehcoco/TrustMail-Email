   },
   "outputs": [],
   "source": [
    "df['unique_word_ratio'] = df['clean_text'].apply(\n",
    "    lambda x: len(set(str(x).split())) / (len(str(x).split()) + 1)\n",
    ")"
   ]
  },
  {
