   "source": [
    "### 19b. McNemar Tests"
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy.stats import chi2\n",
    "def mcnemar_test(y_true, pred_a, pred_b):\n",
    "    \"\"\"\n",
    "    McNemar's test for paired classifiers.\n",
    "    b = A correct, B wrong  |  c = A wrong, B correct\n",
    "    Chi² = (|b - c| - 1)² / (b + c)   (with continuity correction)\n",
    "    Returns: chi2 statistic, p-value, b, c\n",
    "    \"\"\"\n",
    "    y_true  = np.array(y_true)\n",
    "    pred_a  = np.array(pred_a)\n",
    "    pred_b  = np.array(pred_b)\n",
    "    a_right = (pred_a == y_true)\n",
    "    b_right = (pred_b == y_true)\n",
    "    b = np.sum( a_right & ~b_right)\n",
    "    c = np.sum(~a_right &  b_right)\n",
    "    if (b + c) == 0:\n",
    "        return 0.0, 1.0, b, c\n",
    "    stat = (abs(b - c) - 1) ** 2 / (b + c)\n",
    "    p    = 1 - chi2.cdf(stat, df=1)\n",
    "    return stat, p, b, c\n",
    "model_preds_mcnemar = {\n",
    "    \"Logistic Regression\": pred_lr,\n",
    "    \"Random Forest\":       pred_rf,\n",
    "    \"Naive Bayes\":         nb_model.predict(X_test_tfidf),\n",
    "    \"XGBoost\":             xgb_model.predict(X_test_tfidf),\n",
    "    \"Linear SVM\":          svm_model.predict(X_test_final),\n",
    "    \"LightGBM\":            pred_lgbm,\n",
    "    \"Gradient Boosting\":   pred_gbm,\n",
    "    \"AdaBoost\":            pred_ada,\n",
    "    \"Voting Classifier\":   pred_voting,\n",
    "    \"Stacking Classifier\": pred_stacking,\n",
    "}\n",
    "names = list(model_preds_mcnemar.keys())\n",
    "preds = list(model_preds_mcnemar.values())\n",
    "mcnemar_rows = []\n",
    "for i in range(len(names)):\n",
    "    for j in range(i + 1, len(names)):\n",
    "        stat, p, b, c = mcnemar_test(y_test, preds[i], preds[j])\n",
    "        mcnemar_rows.append({\n",
    "            \"Model A\":     names[i],\n",
    "            \"Model B\":     names[j],\n",
    "            \"b (A✓ B✗)\":  int(b),\n",
    "            \"c (A✗ B✓)\":  int(c),\n",
    "            \"Chi²\":        round(stat, 4),\n",
    "            \"p-value\":     round(p, 6),\n",
    "            \"Significant\": \" Yes\" if p < 0.05 else \" No\",\n",
    "        })\n",
    "mcnemar_df = pd.DataFrame(mcnemar_rows).sort_values(\"p-value\")\n",
    "print(\"McNemar Tests - Pairwise Classifier Comparisons\")\n",
    "print(\"(H₀: both classifiers make the same errors; p < 0.05 → significant difference)\\n\")\n",
    "print(mcnemar_df.to_string(index=False))\n",
    "mcnemar_df.to_csv(\n",
    "    \"/content/drive/MyDrive/Phishing_Email/results/mcnemar_tests.csv\",\n",
    "    index=False\n",
    ")\n",
    "print(\"\\nSaved → mcnemar_tests.csv\")"
   ],
