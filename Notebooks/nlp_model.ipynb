    "    auc,\n",
    "    precision_recall_curve,\n",
    "    average_precision_score\n",
    ")\n",
    "\n",
    "\n",
    "RESULTS_DIR = \"/content/drive/MyDrive/Phishing_Email/results\"\n",
    "\n",
    "os.makedirs(\n",
    "    RESULTS_DIR,\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "roc_models = {\n",
    "\n",
    "    \"Logistic Regression\":\n",
    "        (lr, X_test_final),\n",
    "\n",
    "    \"Random Forest\":\n",
    "        (rf_model, X_test_final),\n",
    "\n",
    "    \"Linear SVM\":\n",
    "        (svm_model, X_test_final),\n",
    "\n",
    "    \"Naive Bayes\":\n",
    "        (nb_model, X_test_tfidf),\n",
    "\n",
    "\n",
    "    \"XGBoost\":\n",
    "        (xgb_model, X_test_tfidf),\n",
    "\n",
    "    \"LightGBM\":\n",
    "        (lgbm_model, X_test_tfidf),\n",
    "\n",
    "    \"Gradient Boosting\":\n",
    "        (gbm_model, X_test_tfidf),\n",
    "\n",
    "    \"Passive-Aggressive\":\n",
    "        (pa_model, X_test_tfidf),\n",
    "\n",
    "    \"AdaBoost\":\n",
    "        (ada_model, X_test_tfidf),\n",
    "\n",
    "    \"Voting Classifier\":\n",
    "        (voting_model, X_test_tfidf),\n",
    "\n",
    "    \"Stacking Classifier\":\n",
    "        (stacking_model, X_test_tfidf),\n",
    "}\n",
    "\n",
    "\n",
    "\n",
    "curve_data = {}\n",
    "\n",
    "for name, (model, X_te) in roc_models.items():\n",
    "\n",
    "    print(f\"\\nProcessing: {name}\")\n",
    "\n",
    "    try:\n",
    "\n",
    "\n",
    "        if hasattr(model, \"predict_proba\"):\n",
    "\n",
    "            scores = model.predict_proba(X_te)[:, 1]\n",
    "\n",
    "            score_type = \"predict_proba\"\n",
    "\n",
    "        elif hasattr(model, \"decision_function\"):\n",
    "\n",
    "            scores = model.decision_function(X_te)\n",
    "\n",
    "            score_type = \"decision_function\"\n",
    "\n",
    "        else:\n",
    "\n",
    "            print(\n",
    "                f\"  ✗ Skipping {name}: \"\n",
    "                \"no predict_proba or decision_function\"\n",
    "            )\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "\n",
    "        fpr, tpr, _ = roc_curve(\n",
    "            y_test,\n",
    "            scores\n",
    "        )\n",
    "\n",
    "        roc_auc_val = auc(\n",
    "            fpr,\n",
    "            tpr\n",
    "        )\n",
    "\n",
    "\n",
    "\n",
    "        precision, recall, _ = precision_recall_curve(\n",
    "            y_test,\n",
    "            scores\n",
    "        )\n",
    "\n",
    "        ap = average_precision_score(\n",
    "            y_test,\n",
    "            scores\n",
    "        )\n",
    "\n",
    "\n",
    "\n",
    "        curve_data[name] = {\n",
    "\n",
    "            \"fpr\": fpr,\n",
    "            \"tpr\": tpr,\n",
    "\n",
    "            \"roc_auc\": roc_auc_val,\n",
    "\n",
    "            \"prec\": precision,\n",
    "            \"rec\": recall,\n",
    "\n",
    "            \"ap\": ap,\n",
    "\n",
    "            \"score_type\": score_type\n",
    "        }\n",
    "\n",
    "\n",
    "        print(\n",
    "            f\"  ✓ Score method: {score_type}\"\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f\"  ✓ ROC-AUC: {roc_auc_val:.4f}\"\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f\"  ✓ Average Precision: {ap:.4f}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    except Exception as e:\n",
    "\n",
    "        print(\n",
    "            f\"  ✗ Skipping {name}: {e}\"\n",
    "        )\n",
    "\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 65)\n",
    "\n",
    "print(\n",
    "    f\"Successfully generated curves for \"\n",
    "    f\"{len(curve_data)}/11 models\"\n",
    ")\n",
    "\n",
    "print(\"=\" * 65)\n",
    "\n",
    "for name in curve_data:\n",
    "    print(f\"✓ {name}\")\n",
    "\n",
    "\n",
    "\n",
    "plt.figure(\n",
    "    figsize=(10, 8)\n",
    ")\n",
    "\n",
    "for name, d in curve_data.items():\n",
    "\n",
    "    plt.plot(\n",
    "        d[\"fpr\"],\n",
    "        d[\"tpr\"],\n",
    "        lw=1.8,\n",
    "        label=(\n",
    "            f\"{name} \"\n",
    "            f\"(AUC={d['roc_auc']:.3f})\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "plt.plot(\n",
    "    [0, 1],\n",
    "    [0, 1],\n",
    "    \"k--\",\n",
    "    lw=1,\n",
    "    label=\"Random Baseline\"\n",
    ")\n",
    "\n",
    "\n",
    "plt.xlabel(\n",
    "    \"False Positive Rate\"\n",
    ")\n",
    "\n",
    "plt.ylabel(\n",
    "    \"True Positive Rate\"\n",
    ")\n",
    "\n",
    "plt.title(\n",
    "    \"ROC Curves - All 11 Classical & Ensemble Models\"\n",
    ")\n",
    "\n",
    "plt.legend(\n",
    "    loc=\"lower right\",\n",
    "    fontsize=8\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
    "    f\"{RESULTS_DIR}/roc_curves_all_11_models.png\",\n",
    "    dpi=200,\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "\n",
    "plt.figure(\n",
    "    figsize=(10, 8)\n",
    ")\n",
    "\n",
    "for name, d in curve_data.items():\n",
    "\n",
    "    plt.plot(\n",
    "        d[\"rec\"],\n",
    "        d[\"prec\"],\n",
    "        lw=1.8,\n",
    "        label=(\n",
    "            f\"{name} \"\n",
    "            f\"(AP={d['ap']:.3f})\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "plt.xlabel(\n",
    "    \"Recall\"\n",
    ")\n",
    "\n",
    "plt.ylabel(\n",
    "    \"Precision\"\n",
    ")\n",
    "\n",
    "plt.title(\n",
    "    \"Precision-Recall Curves - All 11 Classical & Ensemble Models\"\n",
    ")\n",
    "\n",
    "plt.legend(\n",
    "    loc=\"lower left\",\n",
    "    fontsize=8\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
    "    f\"{RESULTS_DIR}/pr_curves_all_11_models.png\",\n",
    "    dpi=200,\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "\n",
    "auc_summary = pd.DataFrame({\n",
    "\n",
    "    name: {\n",
    "\n",
    "        \"ROC_AUC\":\n",
    "            d[\"roc_auc\"],\n",
    "\n",
    "        \"Avg_Precision\":\n",
    "            d[\"ap\"]\n",
    "\n",
    "    }\n",
    "\n",
    "    for name, d in curve_data.items()\n",
    "\n",
    "}).T.sort_values(\n",
    "    \"ROC_AUC\",\n",
    "    ascending=False\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "auc_summary.to_csv(\n",
