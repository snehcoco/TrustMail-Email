    "\n",
    "import pandas as pd\n",
    "\n",
    "results = {\n",
    "    \"LightGBM\": evaluate(\n",
    "        \"LightGBM\",\n",
    "        y_test,\n",
    "        pred_lgbm,\n",
    "        prob_lgbm\n",
    "    ),\n",
    "    \"Gradient Boosting\": evaluate(\n",
    "        \"Gradient Boosting\",\n",
    "        y_test,\n",
    "        pred_gbm,\n",
    "        prob_gbm\n",
    "    ),\n",
    "    \"Passive-Aggressive\": evaluate(\n",
    "        \"Passive-Aggressive\",\n",
    "        y_test,\n",
    "        pred_pa,\n",
    "        None\n",
    "    ),\n",
    "    \"AdaBoost\": evaluate(\n",
    "        \"AdaBoost\",\n",
    "        y_test,\n",
    "        pred_ada,\n",
    "        prob_ada\n",
    "    ),\n",
    "    \"Voting Classifier\": evaluate(\n",
    "        \"Voting Classifier\",\n",
    "        y_test,\n",
    "        pred_voting,\n",
    "        prob_voting\n",
    "    ),\n",
    "    \"Stacking Classifier\": evaluate(\n",
    "        \"Stacking Classifier\",\n",
    "        y_test,\n",
    "        pred_stacking,\n",
    "        prob_stacking\n",
    "    ),\n",
    "}\n",
    "\n",
    "results_df = pd.DataFrame(results).T\n",
    "results_df = results_df.sort_values(\"f1\", ascending=False)\n",
    "\n",
    "results_df"
