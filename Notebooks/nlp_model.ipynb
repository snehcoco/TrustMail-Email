    "import pandas as pd\n",
    "import hashlib\n",
    "CSV_PATH = \"/content/drive/MyDrive/Phishing_Email/final_dataset/nlp_final_features_reduced.csv\"\n",
    "TARGET   = 41_000\n",
    "df_og = pd.read_csv(CSV_PATH)\n",
    "n_raw = len(df_og)\n",
    "print(f\"Rows loaded from disk : {n_raw:,}\")\n",
    "print(f\"Class distribution (raw):\\n{df_og['label'].value_counts()}\\n\")\n",
    "df_og.drop_duplicates(inplace=True)\n",
    "n_after_exact = len(df_og)\n",
    "print(f\"After exact-duplicate removal : {n_after_exact:,}  (dropped {n_raw - n_after_exact:,} rows)\")\n",
    "NEAR_DUP_ACTION = \"flag\"\n",
    "def simhash64(text, bits=64):\n",
    "    words = str(text).lower().split()\n",
    "    v     = [0] * bits\n",
    "    for word in words:\n",
    "        h = int(hashlib.md5(word.encode()).hexdigest(), 16)\n",
    "        for i in range(bits):\n",
    "            v[i] += 1 if (h >> i) & 1 else -1\n",
    "    return sum((1 << i) for i in range(bits) if v[i] > 0)\n",
    "def hamming(a, b):\n",
    "    return bin(a ^ b).count(\"1\")\n",
    "TEXT_COL = \"body\" if \"body\" in df_og.columns else df_og.select_dtypes(\"object\").columns[0]\n",
    "print(f\"Near-duplicate audit uses column: '{TEXT_COL}'\")\n",
    "df_og[\"_simhash\"] = df_og[TEXT_COL].apply(simhash64)\n",
    "SIM_THRESHOLD = 3\n",
    "hashes = df_og[\"_simhash\"].tolist()\n",
    "near_dup_mask = [False] * len(hashes)\n",
    "seen = []\n",
    "for idx, h in enumerate(hashes):\n",
    "    if any(hamming(h, s) <= SIM_THRESHOLD for s in seen):\n",
    "        near_dup_mask[idx] = True\n",
    "    else:\n",
    "        seen.append(h)\n",
    "df_og[\"_near_dup\"] = near_dup_mask\n",
    "n_near_dups = sum(near_dup_mask)\n",
    "print(f\"Near-duplicate rows detected (Hamming <= {SIM_THRESHOLD}) : {n_near_dups:,}\")\n",
    "print(f\"Near-dup class breakdown:\\n{df_og[df_og['_near_dup']]['label'].value_counts()}\\n\")\n",
    "if NEAR_DUP_ACTION == \"drop\":\n",
    "    df_og = df_og[~df_og[\"_near_dup\"]].copy()\n",
    "    print(f\"Near-duplicates DROPPED.  Rows remaining: {len(df_og):,}\")\n",
    "n_before_cap = len(df_og)\n",
    "if n_before_cap > TARGET:\n",
    "    df = (df_og\n",
    "          .groupby(\"label\", group_keys=False)\n",
    "          .apply(lambda g: g.sample(\n",
    "              n=round(TARGET * len(g) / n_before_cap),\n",
    "              random_state=42))\n",
    "          .sample(frac=1, random_state=42)\n",
    "          .reset_index(drop=True))\n",
    "    df = df.iloc[:TARGET]\n",
    "else:\n",
    "    df = df_og.copy()\n",
    "df.drop(columns=[\"_simhash\", \"_near_dup\"], inplace=True, errors=\"ignore\")\n",
    "n_final = len(df)\n",
    "print(\"=\" * 55)\n",
    "print(\"  DATASET AUDIT SUMMARY\")\n",
    "print(\"=\" * 55)\n",
    "print(f\"  Raw rows loaded          : {n_raw:,}\")\n",
    "print(f"
   ]
