   "source": [
    "### 19a. Bootstrap 95% Confidence Intervals"
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "def bootstrap_ci(y_true, y_pred, metric_fn, n_bootstrap=2000, ci=0.95, random_state=42):\n",
    "    \"\"\"Bootstrap confidence interval for any sklearn metric function.\"\"\"\n",
    "    rng = np.random.RandomState(random_state)\n",
    "    y_true = np.array(y_true)\n",
    "    y_pred = np.array(y_pred)\n",
    "    scores = []\n",
    "    for _ in range(n_bootstrap):\n",
    "        idx = rng.choice(len(y_true), size=len(y_true), replace=True)\n",
    "        scores.append(metric_fn(y_true[idx], y_pred[idx], zero_division=0))\n",
    "    alpha = (1 - ci) / 2\n",
    "    lower = np.percentile(scores, 100 * alpha)\n",
    "    upper = np.percentile(scores, 100 * (1 - alpha))\n",
    "    return lower, upper\n",
    "\n",
    "from sklearn.metrics import f1_score, recall_score\n",
    "\n",
    "model_preds = {\n",
    "    \"Logistic Regression\":     pred_lr,\n",
    "    \"Random Forest\":           pred_rf,\n",
    "    \"Naive Bayes\":             nb_model.predict(X_test_tfidf),\n",
    "    \"XGBoost\":                 xgb_model.predict(X_test_tfidf),\n",
    "    \"Linear SVM\":              svm_model.predict(X_test_final),\n",
    "    \"LightGBM\":                pred_lgbm,\n",
    "    \"Gradient Boosting\":       pred_gbm,\n",
    "    \"AdaBoost\":                pred_ada,\n",
    "    \"Voting Classifier\":       pred_voting,\n",
    "    \"Stacking Classifier\":     pred_stacking,\n",
    "}\n",
    "\n",
    "ci_rows = []\n",
    "for name, y_pred in model_preds.items():\n",
    "    f1_lo, f1_hi   = bootstrap_ci(y_test, y_pred, f1_score)\n",
    "    rec_lo, rec_hi = bootstrap_ci(y_test, y_pred, recall_score)\n",
    "    ci_rows.append({\n",
    "        \"Model\":          name,\n",
    "        \"F1\":             f1_score(y_test, y_pred, zero_division=0),\n",
    "        \"F1_CI_lower\":    f1_lo,\n",
    "        \"F1_CI_upper\":    f1_hi,\n",
    "        \"Recall\":         recall_score(y_test, y_pred, zero_division=0),\n",
    "        \"Recall_CI_lower\": rec_lo,\n",
    "        \"Recall_CI_upper\": rec_hi,\n",
    "    })\n",
    "\n",
    "ci_df = pd.DataFrame(ci_rows).sort_values(\"F1\", ascending=False).reset_index(drop=True)\n",
    "\n",
    "ci_df[\"F1 [95% CI]\"]     = ci_df.apply(lambda r: f\"{r['F1']:.4f}  [{r['F1_CI_lower']:.4f}, {r['F1_CI_upper']:.4f}]\", axis=1)\n",
    "ci_df[\"Recall [95% CI]\"] = ci_df.apply(lambda r: f\"{r['Recall']:.4f}  [{r['Recall_CI_lower']:.4f}, {r['Recall_CI_upper']:.4f}]\", axis=1)\n",
    "\n",
    "print(\"Bootstrap 95% Confidence Intervals (2000 resamples)\\n\")\n",
    "print(ci_df[[\"Model\", \"F1 [95% CI]\", \"Recall [95% CI]\"]].to_string(index=False))\n",
    "\n",
    "import os\n",
    "os.makedirs(\"/content/drive/MyDrive/Phishing_Email/results\", exist_ok=True)\n",
    "ci_df.to_csv(\"/content/drive/MyDrive/Phishing_Email/results/bootstrap_ci.csv\", index=False)\n",
    "print(\"\\nSaved → bootstrap_ci.csv\")"
   ],
