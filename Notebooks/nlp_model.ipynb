   "source": [
    "## 23. Final Summary - All Models with Bootstrap CIs"
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy.stats import chi2\n",
    "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\n",
    "def bootstrap_ci(y_true, y_pred, metric_fn, n_bootstrap=2000, ci=0.95, random_state=42):\n",
    "    \"\"\"Bootstrap confidence interval for any sklearn metric function.\"\"\"\n",
    "    rng = np.random.RandomState(random_state)\n",
    "    y_true = np.array(y_true)\n",
    "    y_pred = np.array(y_pred)\n",
    "    scores = []\n",
    "    for _ in range(n_bootstrap):\n",
    "        idx = rng.choice(len(y_true), size=len(y_true), replace=True)\n",
    "        scores.append(metric_fn(y_true[idx], y_pred[idx], zero_division=0))\n",
    "    alpha = (1 - ci) / 2\n",
    "    lower = np.percentile(scores, 100 * alpha)\n",
    "    upper = np.percentile(scores, 100 * (1 - alpha))\n",
    "    return lower, upper\n",
    "def mcnemar_test(y_true, pred_a, pred_b):\n",
    "    \"\"\"\n",
    "    McNemar's test for paired classifiers.\n",
    "    b = A correct, B wrong  |  c = A wrong, B correct\n",
    "    Chi² = (|b - c| - 1)² / (b + c)   (with continuity correction)\n",
    "    Returns: chi2 statistic, p-value, b, c\n",
    "    \"\"\"\n",
    "    y_true  = np.array(y_true)\n",
    "    pred_a  = np.array(pred_a)\n",
    "    pred_b  = np.array(pred_b)\n",
    "    a_right = (pred_a == y_true)\n",
    "    b_right = (pred_b == y_true)\n",
    "    b = np.sum( a_right & ~b_right)\n",
    "    c = np.sum(~a_right &  b_right)\n",
    "    if (b + c) == 0:\n",
    "        return 0.0, 1.0, b, c\n",
    "    stat = (abs(b - c) - 1) ** 2 / (b + c)\n",
    "    p    = 1 - chi2.cdf(stat, df=1)\n",
    "    return stat, p, b, c\n",
    "model_preds_final = {\n",
    "    \"Logistic Regression\": pred_lr,\n",
    "    \"Random Forest\":       pred_rf,\n",
    "    \"Naive Bayes\":         nb_model.predict(X_test_tfidf),\n",
    "    \"XGBoost\":             xgb_model.predict(X_test_tfidf),\n",
    "    \"Linear SVM\":          svm_model.predict(X_test_final),\n",
    "    \"LightGBM\":            pred_lgbm,\n",
    "    \"Gradient Boosting\":   pred_gbm,\n",
    "    \"AdaBoost\":            pred_ada,\n",
    "    \"Voting Classifier\":   pred_voting,\n",
    "    \"Stacking Classifier\": pred_stacking,\n",
    "}\n",
    "summary_rows = []\n",
    "for name, y_pred in model_preds_final.items():\n",
    "    acc  = accuracy_score(y_test, y_pred)\n",
    "    prec = precision_score(y_test, y_pred, zero_division=0)\n",
    "    rec  = recall_score(y_test, y_pred, zero_division=0)\n",
    "    f1   = f1_score(y_test, y_pred, zero_division=0)\n",
    "    f1_lo,  f1_hi  = bootstrap_ci(y_test, y_pred, f1_score)\n",
    "    rec_lo, rec_hi = bootstrap_ci(y_test, y_pred, recall_score)\n",
    "    summary_rows.append({\n",
    "        \"Model\":            name,\n",
    "        \"Accuracy\":         round(acc,  4),\n",
    "        \"Precision\":        round(prec, 4),\n",
    "        \"Recall\":           round(rec,  4),\n",
    "        \"Recall_CI\":        f\"[{rec_lo:.4f}, {rec_hi:.4f}]\",\n",
    "        \"F1\":               round(f1,   4),\n",
    "        \"F1_CI\":            f\"[{f1_lo:.4f}, {f1_hi:.4f}]\",\n",
    "    })\n",
    "summary_df = (\n",
    "    pd.DataFrame(summary_rows)\n",
    "    .sort_values(\"F1\", ascending=False)\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "print(\"=\" * 90)\n",
    "print(\"FINAL RESULTS - Point Estimates + Bootstrap 95% Confidence Intervals\")\n",
    "print(\"=\" * 90)\n",
    "print(summary_df.to_string(index=False))\n",
    "summary_df.to_csv(\n",
    "    \"/content/drive/MyDrive/Phishing_Email/results/final_summary_with_ci.csv\",\n",
    "    index=False\n",
    ")\n",
    "print(\"\\nSaved → final_summary_with_ci.csv\")\n",
    "best_name  = summary_df.iloc[0][\"Model\"]\n",
    "second_name = summary_df.iloc[1][\"Model\"]\n",
    "pred_best   = model_preds_final[best_name]\n",
    "pred_second = model_preds_final[second_name]\n",
    "stat, p, b, c = mcnemar_test(y_test, pred_best, pred_second)\n",
    "print(f\"\\nMcNemar: {best_name} vs {second_name}\")\n",
    "print(f\"  Chi² = {stat:.4f},  p = {p:.6f}\")\n",
    "print(f\"  → {'Significant difference' if p < 0.05 else 'No significant difference'}\")"
   ],
